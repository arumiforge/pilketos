#--------------------------------------------------------------------
# Salin file ini menjadi ".env" pada root project, lalu sesuaikan.
# JANGAN commit file .env ke version control.
# Panduan lengkap: README.md bagian 5 (.env) dan 7 (Deployment Laragon).
#--------------------------------------------------------------------

# development saat pengembangan, production saat hari pemilihan
# (Debug Toolbar & detail error teknis mati, DatabaseSeeder menolak berjalan).
CI_ENVIRONMENT = development

# Alamat yang dibuka SEMUA perangkat, sama persis (termasuk port/subfolder),
# diakhiri "/". Contoh:
#   Laragon di laptop server saja : http://smp1dawe-osis-2026.test/
#   HP/komputer lain di Wi-Fi      : http://192.168.1.10/   (IP laptop server)
#   php spark serve                : http://localhost:8080/
app.baseURL = 'http://smp1dawe-osis-2026.test/'

# Content-Security-Policy aktif (bawaan). Matikan hanya sementara untuk diagnosis.
# app.CSPEnabled = false

#--------------------------------------------------------------------
# BERANDA (opsional; bawaan di app/Config/Homepage.php, README bagian 21)
#--------------------------------------------------------------------
# Perolehan suara (persentase per pasangan + partisipasi) tampil publik
# di beranda. false = hanya pasangan calon tanpa angka.
# homepage.publicLiveCount = false
# homepage.livePollSeconds = 30

# Ganti logo, latar layar pembuka, dan ilustrasi pintu masuk. Path relatif
# ke folder public/ (simpan di public/assets/img/..., bukan public/uploads/).
# homepage.logoOnDark   = 'assets/img/brand/logo-putih.svg'
# homepage.logoOnLight  = 'assets/img/brand/logo-hitam.svg'
# homepage.introDesktop = 'assets/img/home/pembuka-1920x1080.webp'
# homepage.introMobile  = 'assets/img/home/pembuka-1080x1920.webp'
# homepage.entryStudent = 'assets/img/home/siswa.webp'
# homepage.entryTeacher = 'assets/img/home/guru.webp'

#--------------------------------------------------------------------
# DATABASE (MySQL 8.0.16+ / MariaDB 10.4+)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = smp1dawe_osis_2026
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Database khusus test otomatis (vendor/bin/phpunit). Isinya dihapus
# dan dibuat ulang setiap test, JANGAN arahkan ke database utama.
database.tests.hostname = localhost
database.tests.database = smp1dawe_osis_2026_test
database.tests.username = root
database.tests.password =
database.tests.port = 3306

#--------------------------------------------------------------------
# SESSION & COOKIE
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'osis_session'
session.expiration = 7200
session.matchIP = false

# true bila situs dibuka lewat HTTPS.
cookie.secure = false
